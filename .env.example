# Web 与三类持久化数据
BUSINESS_DB_PATH=var/business.sqlite
CHECKPOINT_DB_PATH=var/checkpoints.sqlite
MEMORY_DB_PATH=var/memory.sqlite
POLICY_SOURCE_PATH=data/policies
POLICY_INDEX_DB_PATH=var/policy-index.sqlite
FRONTEND_DIST_PATH=frontend/dist

# 本地单实例 Web
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
SESSION_TTL_HOURS=24
GUEST_SESSION_TTL_HOURS=2
COOKIE_SECURE=false
CHAT_MESSAGE_MAX_LENGTH=2000

# 注册用户 LLM 权限与每日额度
LLM_FEATURE_ENABLED=true
LLM_DAILY_CALL_LIMIT=20
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
