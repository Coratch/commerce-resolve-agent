      "region": "CN",
      "status": "published",
      "path": "refunds-v1.md",
      "sections": [
        {
          "section_id": "refund-eligibility",
          "heading": "直接整单退款资格",
          "topic": "refund",
          "aspects": ["conditions"],
          "aliases": ["发货前退款", "取消订单退款", "直接整单退款"],
          "facts": [
            {
              "fact_id": "refund.eligibility.pre_fulfillment",
              "claim_text": "订单在发货前或已取消、原支付已结算且没有活动或已完成退款时，可以申请当前可退余额的整单退款。",
              "rule_key": "refund.pre_fulfillment_eligibility",
              "normalized_value": "processing_or_cancelled_before_shipment",
              "scope": {},
              "required_dimensions": []
            }
          ]
        },
        {
          "section_id": "refund-timing",
          "heading": "退款到账时间",
          "topic": "refund",
          "aspects": ["timing"],
          "aliases": ["多久到账", "退款时间", "工作日"],
          "facts": [
            {
              "fact_id": "refund.timing.standard",
              "claim_text": "退款申请审核通过后，款项将在 3 至 5 个工作日内原路退回。",
              "rule_key": "refund.processing_days",
              "normalized_value": "3-5_business_days",
              "scope": {},
              "required_dimensions": []
            }
          ]
        },
        {
          "section_id": "refund-method",
          "heading": "退款方式",
          "topic": "refund",
          "aspects": ["method"],
          "aliases": ["退到哪里", "原路退回", "退款渠道"],
          "facts": [
            {
              "fact_id": "refund.method.original",
              "claim_text": "退款默认退回原支付方式；原支付方式不可用时需要人工客服确认替代方式。",
              "rule_key": "refund.method",
              "normalized_value": "original_payment_method",
              "scope": {},
              "required_dimensions": []
            }
          ]
        },
        {
          "section_id": "refund-process",
          "heading": "退款流程",
          "topic": "refund",
          "aspects": ["process", "conditions"],
          "aliases": ["怎么退款", "退款审核", "售后申请"],
          "facts": [
            {
              "fact_id": "refund.process.application",
              "claim_text": "用户需要先提交售后申请，退款仅在审核通过后进入处理流程。",
              "rule_key": "refund.process",
              "normalized_value": "apply_then_review",
              "scope": {},
              "required_dimensions": []
            }
          ]
        }
      ]
    },
