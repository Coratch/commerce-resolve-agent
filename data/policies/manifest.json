  "documents": [
    {
      "document_id": "returns-policy",
      "title": "退货政策",
      "version": "1.0",
      "effective_from": "2026-01-01",
      "effective_to": null,
      "region": "CN",
      "status": "published",
      "path": "returns-v1.md",
      "sections": [
        {
          "section_id": "return-window",
          "heading": "退货期限",
          "topic": "return",
          "aspects": ["window"],
          "aliases": ["七天无理由", "退货期限", "多少天可以退"],
          "facts": [
            {
              "fact_id": "return.window.general",
              "claim_text": "普通商品签收后 7 天内可以申请无理由退货。",
              "rule_key": "return.window_days",
              "normalized_value": "7",
              "scope": {},
              "required_dimensions": []
            }
          ]
        },
        {
          "section_id": "return-conditions",
          "heading": "退货条件",
          "topic": "return",
          "aspects": ["conditions"],
          "aliases": ["拆封后退货", "退货要求", "商品完好"],
          "facts": [
            {
              "fact_id": "return.conditions.opened-general",
              "claim_text": "普通商品拆封后如仍保持完好且不影响二次销售，可以申请退货。",
              "rule_key": "return.opened_eligibility",
              "normalized_value": "allowed_if_resalable",
              "scope": {
                "product_categories": ["general", "apparel"],
                "opened": true
              },
              "required_dimensions": ["product_category", "opened"]
            },
            {
              "fact_id": "return.conditions.opened-hygiene",
              "claim_text": "已拆封的卫生用品不支持无理由退货。",
              "rule_key": "return.opened_eligibility",
              "normalized_value": "not_allowed",
              "scope": {
                "product_categories": ["hygiene"],
                "opened": true
              },
              "required_dimensions": ["product_category", "opened"]
            },
            {
              "fact_id": "return.conditions.activated-digital",
              "claim_text": "已激活的数字商品不支持无理由退货。",
              "rule_key": "return.opened_eligibility",
              "normalized_value": "not_allowed",
              "scope": {
                "product_categories": ["digital"],
                "opened": true
              },
              "required_dimensions": ["product_category", "opened"]
            },
            {
              "fact_id": "return.conditions.unopened",
              "claim_text": "未拆封且保持完好的商品可以按照对应期限申请退货。",
              "rule_key": "return.opened_eligibility",
              "normalized_value": "allowed",
              "scope": {
                "product_categories": ["general", "apparel", "hygiene"],
                "opened": false
              },
              "required_dimensions": ["product_category", "opened"]
            }
          ]
        },
        {
          "section_id": "return-exceptions",
          "heading": "退货例外",
          "topic": "return",
          "aspects": ["exception"],
          "aliases": ["哪些不能退", "特殊商品", "退货例外"],
          "facts": [
            {
              "fact_id": "return.exception.categories",
              "claim_text": "定制商品、已激活数字商品和已拆封卫生用品不适用无理由退货。",
              "rule_key": "return.excluded_categories",
              "normalized_value": "custom,digital_activated,hygiene_opened",
              "scope": {},
              "required_dimensions": []
            }
          ]
        },
        {
          "section_id": "return-shipping-fee",
          "heading": "退货运费",
          "topic": "return",
          "aspects": ["shipping_fee"],
          "aliases": ["退货邮费", "谁承担运费", "质量问题运费"],
          "facts": [
            {
              "fact_id": "return.shipping-fee.general",
              "claim_text": "因商品质量问题产生的退货运费由商家承担；无质量问题的无理由退货运费由消费者承担。",
              "rule_key": "return.shipping_fee",
              "normalized_value": "merchant_if_quality_issue_else_customer",
              "scope": {},
              "required_dimensions": []
            }
          ]
        },
        {
          "section_id": "return-process",
          "heading": "退货流程",
          "topic": "return",
          "aspects": ["process"],
          "aliases": ["怎么退货", "退货步骤", "寄回商品"],
          "facts": [
            {
              "fact_id": "return.process.application",
              "claim_text": "用户需要先提交退货申请，并在审核通过后按照页面指引寄回商品。",
              "rule_key": "return.process",
              "normalized_value": "apply_then_ship_after_approval",
              "scope": {},
              "required_dimensions": []
            }
          ]
        }
      ]
    },
    {
      "document_id": "refunds-policy",
