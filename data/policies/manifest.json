      "sections": [
        {
          "section_id": "exchange-window",
          "heading": "换货期限",
          "topic": "exchange",
          "aspects": ["window"],
          "aliases": ["多少天换货", "换货期限", "十五天"],
          "facts": [
            {
              "fact_id": "exchange.window.general",
              "claim_text": "普通商品签收后 15 天内可以申请换货。",
              "rule_key": "exchange.window_days",
              "normalized_value": "15",
              "scope": {},
              "required_dimensions": []
            }
          ]
        },
        {
          "section_id": "exchange-conditions",
          "heading": "换货条件",
          "topic": "exchange",
          "aspects": ["conditions"],
          "aliases": ["换货要求", "商品完好", "订单信息"],
          "facts": [
            {
              "fact_id": "exchange.conditions.general",
              "claim_text": "换货商品应保持完好、不影响二次销售，并提供有效订单信息。",
              "rule_key": "exchange.conditions",
              "normalized_value": "resalable_with_order",
              "scope": {},
              "required_dimensions": []
            }
          ]
        },
        {
          "section_id": "exchange-process",
          "heading": "换货流程与例外",
          "topic": "exchange",
          "aspects": ["process", "exception"],
          "aliases": ["换货流程", "没有库存", "换货失败"],
          "facts": [
            {
              "fact_id": "exchange.process.stock",
              "claim_text": "换货申请审核通过后，商家在有可用库存时安排替换商品。",
              "rule_key": "exchange.process",
              "normalized_value": "replace_if_stock_available",
              "scope": {},
              "required_dimensions": []
            },
            {
              "fact_id": "exchange.exception.no-stock",
              "claim_text": "没有可用库存时不能完成换货，用户可以改为按照退货政策处理。",
              "rule_key": "exchange.no_stock",
              "normalized_value": "fallback_to_return",
              "scope": {},
              "required_dimensions": []
            }
          ]
        }
      ]
    }
  ]
